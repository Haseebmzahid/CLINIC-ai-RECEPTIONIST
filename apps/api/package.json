{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "set-claims": "tsx scripts/set-claims.ts"
  },
  "dependencies": {
    "@clinic-ai/shared": "workspace:*",
    "@sentry/node": "^10.58.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^14.0.0",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
