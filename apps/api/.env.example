# API runtime
NODE_ENV=
PORT=3001
APP_BASE_URL=
ALLOWED_ORIGIN=http://localhost:3000

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CONFIRMATION_TEMPLATE_NAME=appointment_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Secrets and observability
SECRETS_PROVIDER=
LOG_LEVEL=
APP_RELEASE=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TEST_ENABLED=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate limits and caches
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
TENANT_RATE_LIMIT_WINDOW_MS=60000
TENANT_RATE_LIMIT_MAX=300
SETTINGS_CACHE_TTL_MS=30000
TENANT_CACHE_TTL_MS=30000
